<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ronllan.modules.sys.dao.SysDictTypeDao">

	<resultMap id="SysDictTypeEntity" type="com.ronllan.modules.sys.entity.SysDictTypeEntity"></resultMap>
    
    <select id="getList" resultMap="SysDictTypeEntity">
		select 
			sysDictType.*
		from sys_dict_type sysDictType 
		<where>
			<if test="dictType != null and dictType.trim() != ''">
				and sysDictType.dict_type like #{dictType}
			</if>
			<if test="dictName != null and dictName.trim() != ''">
				and sysDictType.dict_name like #{dictName}
			</if>
		</where>
	</select>
	
</mapper>